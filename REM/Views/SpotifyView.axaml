<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:REM.ViewModels"
             xmlns:svc="using:REM.Services"
             x:Class="REM.Views.SpotifyView"
             x:DataType="vm:SpotifyViewModel">

  <UserControl.Styles>
    <Style Selector="Border.lyric-line">
      <Setter Property="Opacity" Value="0.62" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Border.lyric-line.past">
      <Setter Property="Opacity" Value="0.34" />
    </Style>
    <Style Selector="Border.lyric-line.active">
      <Setter Property="Opacity" Value="1.0" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Color="#00FFFFFF" Offset="0" />
          <GradientStop Color="#22FFFFFF" Offset="0.16" />
          <GradientStop Color="#22FFFFFF" Offset="0.84" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>
    <Style Selector="Border.lyric-line.animated">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.24" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#BottomPlayerBar">
      <Setter Property="Opacity" Value="1.0" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#BottomPlayerBar.lyrics-autohide-hidden">
      <Setter Property="Opacity" Value="0.0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.lyric-text">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Border.lyric-line.active TextBlock.lyric-text">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.lyric-text.animated">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.22" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.virtual-tracks ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.virtual-tracks ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.virtual-tracks ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SpotifyTrackRowTemplate" DataType="vm:SpotifyTrackRowViewModel">
      <Border Classes="rem-card"
              Padding="10,8"
              Margin="0,0,0,6"
              ContextRequested="OnTrackRowContextRequested">
        <Grid ColumnDefinitions="26,Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding Index}"
                     Classes="muted"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

          <Border Grid.Column="1"
                  Width="38" Height="38"
                  CornerRadius="6"
                  Background="{DynamicResource SurfaceAltBrush}"
                  ClipToBounds="True"
                  Margin="6,0,12,0"
                  IsVisible="{Binding ShowCover}"
                  VerticalAlignment="Center">
            <Grid>
              <Image Source="{Binding CoverBitmap}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding HasCover}" />
              <PathIcon Data="{x:Static svc:IconCatalog.MusicNote}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Width="15" Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !HasCover}" />
            </Grid>
          </Border>

          <Button Grid.Column="2"
                  Command="{Binding PlayCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalAlignment="Center"
                  Cursor="Hand">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Artists}"
                         Classes="muted"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>

          <Button Grid.Column="3"
                  Classes="rem-icon"
                  Command="{Binding ToggleLikeCommand}"
                  ToolTip.Tip="{Binding LikeTooltip}"
                  Margin="8,0,6,0"
                  VerticalAlignment="Center">
            <Grid>
              <PathIcon Data="{x:Static svc:IconCatalog.Heart}"
                        Foreground="#1DB954"
                        Width="13" Height="13"
                        IsVisible="{Binding IsLiked}" />
              <PathIcon Data="{x:Static svc:IconCatalog.Plus}"
                        Width="12" Height="12"
                        IsVisible="{Binding !IsLiked}" />
            </Grid>
          </Button>

          <TextBlock Grid.Column="4"
                     Text="{Binding DurationDisplay}"
                     Classes="muted"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <!-- Dynamic Ambient Glow Backdrop (extracted from 32x32 album cover) -->
    <Border IsHitTestVisible="False"
            Background="{Binding EffectiveAmbientGlowBrush}" />

    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Hideable Top Module Status & Controls Bar -->
      <Border Grid.Row="0"
              IsVisible="{Binding IsHeaderVisible}"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="0,0,0,1"
              Padding="20,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="36" Height="36"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  Background="{Binding AccentBrush}">
            <PathIcon Data="{Binding IconGeometry}"
                      Width="17" Height="17"
                      Foreground="#FFFFFF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Classes="status-badge running-ui" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateLabel}" Classes="status-badge-text running-ui" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding StatusSummary}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="rem-soft" Command="{Binding MinimizeToHeadlessCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{x:Static svc:IconCatalog.Headless}" Width="14" Height="14" />
                <TextBlock Text="Headless" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rem-soft" Command="{Binding PauseModuleCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{x:Static svc:IconCatalog.Pause}" Width="13" Height="13" />
                <TextBlock Text="Pause" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rem-danger" Command="{Binding KillCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{x:Static svc:IconCatalog.Kill}" Foreground="{DynamicResource DangerFgBrush}" Width="13" Height="13" />
                <TextBlock Text="Kill" Foreground="{DynamicResource DangerFgBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rem-btn" Command="{Binding BackToDashboardCommand}" Padding="12,7" FontSize="12">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{x:Static svc:IconCatalog.Home}" Width="13" Height="13" />
                <TextBlock Text="Hub" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rem-icon" Command="{Binding ToggleHeaderCommand}" ToolTip.Tip="Hide status bar">
              <PathIcon Data="{x:Static svc:IconCatalog.ChevronUp}" Width="14" Height="14" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Middle Workspace: Slim Left Nav + Main Content + Toggleable Right Drawer -->
      <Grid Grid.Row="1" ColumnDefinitions="204,*,Auto">

        <!-- Slim Left Navigation -->
        <Border Grid.Column="0"
                Background="#99101319"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,14">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <Button Classes="sidebar-tab"
                      Classes.active="{Binding IsHomeSection}"
                      Command="{Binding SelectHomeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Data="{x:Static svc:IconCatalog.Sparkles}" Width="14" Height="14" />
                  <TextBlock Text="Home / FYP" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="sidebar-tab"
                      Classes.active="{Binding IsSearchSection}"
                      Command="{Binding SelectSearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Data="{x:Static svc:IconCatalog.Search}" Width="14" Height="14" />
                  <TextBlock Text="Search" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="sidebar-tab"
                      Classes.active="{Binding IsCollectionSection}"
                      Command="{Binding SelectLikedSongsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Data="{x:Static svc:IconCatalog.Heart}" Width="14" Height="14" />
                  <TextBlock Text="Liked Songs" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="sidebar-tab"
                      Classes.active="{Binding IsSavedAlbumsSection}"
                      Command="{Binding SelectSavedAlbumsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Data="{x:Static svc:IconCatalog.Disc}" Width="14" Height="14" />
                  <TextBlock Text="Saved Albums" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="sidebar-tab"
                      Classes.active="{Binding IsTopArtistsSection}"
                      Command="{Binding SelectTopArtistsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Data="{x:Static svc:IconCatalog.Radio}" Width="14" Height="14" />
                  <TextBlock Text="Top Artists" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8" Margin="6,14,6,8">
              <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="YOUR PLAYLISTS"
                           Classes="muted"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="rem-icon"
                        Command="{Binding OpenCreatePlaylistModalCommand}"
                        ToolTip.Tip="Create New Playlist"
                        Padding="4,2">
                  <PathIcon Data="{x:Static svc:IconCatalog.Plus}" Width="11" Height="11" />
                </Button>
              </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Playlists}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:SpotifyPlaylistNavViewModel">
                    <Button Classes="sidebar-tab"
                            Classes.active="{Binding IsSelected}"
                            Command="{Binding SelectCommand}"
                            ContextRequested="OnPlaylistRowContextRequested"
                            Padding="8,7"
                            Margin="0,0,0,2">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="5"
                                Background="{DynamicResource SurfaceAltBrush}"
                                ClipToBounds="True"
                                Margin="0,0,8,0"
                                IsVisible="{Binding ShowCoverIcon}"
                                VerticalAlignment="Center">
                          <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding TrackCountText}"
                                     Classes="muted"
                                     FontSize="10"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <PathIcon Grid.Column="2"
                                  Data="{x:Static svc:IconCatalog.Pin}"
                                  Foreground="#1DB954"
                                  Width="11" Height="11"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsPinned}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="10,8"
                    Margin="0,6,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,6,0">
                  <TextBlock Text="Engine" Classes="muted" FontSize="10" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding EngineStatusText}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="rem-icon"
                        Command="{Binding RetryEngineCommand}"
                        ToolTip.Tip="Reconnect / Start Spotify Soloist">
                  <PathIcon Data="{x:Static svc:IconCatalog.Refresh}" Width="12" Height="12" />
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Main View Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

          <!-- Top Search + Utility Toolbar -->
          <Border Grid.Row="0"
                  BorderBrush="{DynamicResource BorderSoftBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="18,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
              <Button Grid.Column="0"
                      Classes="rem-icon"
                      Command="{Binding NavigateBackCommand}"
                      IsVisible="{Binding CanNavigateBack}"
                      ToolTip.Tip="Back"
                      Margin="0,0,8,0">
                <TextBlock Text="←" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
              </Button>

              <TextBox Grid.Column="1"
                       Classes="rem"
                       Watermark="Search songs, artists, albums, or playlists..."
                       Text="{Binding SearchQuery}"
                       Margin="0,0,8,0">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <Button Grid.Column="2"
                      Classes="rem-primary"
                      Command="{Binding SearchCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Content="Search"
                      Margin="0,0,8,0" />

              <Button Grid.Column="3"
                      Classes="rem-icon"
                      Command="{Binding OpenSettingsCommand}"
                      ToolTip.Tip="Spotify &amp; API Settings"
                      Margin="0,0,2,0">
                <PathIcon Data="{x:Static svc:IconCatalog.Settings}" Width="15" Height="15" />
              </Button>

              <Button Grid.Column="4"
                      Classes="rem-icon"
                      Command="{Binding ToggleHeaderCommand}"
                      IsVisible="{Binding !IsHeaderVisible}"
                      ToolTip.Tip="Show status &amp; lifecycle bar">
                <PathIcon Data="{x:Static svc:IconCatalog.ChevronDown}" Width="15" Height="15" />
              </Button>
            </Grid>
          </Border>

          <!-- Busy Progress Bar -->
          <ProgressBar Grid.Row="1"
                       IsIndeterminate="{Binding IsBusy}"
                       Height="2"
                       IsVisible="{Binding IsBusy}"
                       Foreground="{DynamicResource PrimaryAccentBrush}" />

          <!-- Soloist Setup / Connect Pairing Cards -->
          <StackPanel Grid.Row="2" Spacing="8" Margin="18,12,18,0">
            <Border Classes="rem-card"
                    Padding="16"
                    IsVisible="{Binding NeedsSoloistApiKey}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" Margin="0,0,14,0">
                  <TextBlock Text="Add Spotify Soloist API Key" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Paste your personal Spotify Soloist API Key (from developer.spotify.com) into Settings → Spotify &amp; APIs to start official lossless Spotify playback."
                             Classes="muted"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="rem-primary"
                        Command="{Binding OpenSettingsCommand}"
                        Content="Open Settings"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="rem-card"
                    Padding="16"
                    IsVisible="{Binding NeedsConnectPairing}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" Margin="0,0,14,0">
                  <TextBlock Text="Pair REM in Spotify Connect (One-Time)" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Open Spotify on your phone or browser and select the 'REM' speaker device once to authenticate Spotify Soloist, then control everything from REM."
                             Classes="muted"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="rem-soft"
                          Command="{Binding ActivateDeviceCommand}"
                          Content="Activate REM" />
                  <Button Classes="rem-primary"
                          Command="{Binding OpenSettingsCommand}"
                          Content="Settings" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Scrollable Content View (non-virtualized pages) -->
          <ScrollViewer Grid.Row="3"
                        HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding !IsCollectionSection}">
            <StackPanel Spacing="14" Margin="18,14,18,48">

              <!-- SECTION: HOME / FYP -->
              <StackPanel Spacing="14" IsVisible="{Binding IsHomeSection}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <StackPanel Spacing="2" Margin="0,0,12,0">
                    <TextBlock Text="For You" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FypSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>

                  <CheckBox Grid.Column="1"
                            Content="Deep Cuts"
                            IsChecked="{Binding PreferDeepCuts}"
                            ToolTip.Tip="Bias personal mixes and radio toward less mainstream / deep cut tracks"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />

                  <Button Grid.Column="2"
                          Classes="rem-soft"
                          Command="{Binding RefreshFypCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{x:Static svc:IconCatalog.Refresh}" Width="13" Height="13" />
                      <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="3"
                          Classes="rem-primary"
                          Command="{Binding PlayActiveCollectionCommand}"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{x:Static svc:IconCatalog.Play}" Foreground="{DynamicResource TextOnAccentBrush}" Width="13" Height="13" />
                      <TextBlock Text="Play Mix" Foreground="{DynamicResource TextOnAccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <Border Classes="rem-card" Padding="16" IsVisible="{Binding !HasWebApiAuth}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" Margin="0,0,12,0">
                      <TextBlock Text="Connect Spotify Web API (PKCE)" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="Add your Spotify Client ID in Settings → Spotify &amp; APIs (with optional Last.fm API Key) for Personalized FYP, Mixes, Search, Artists, Liked Songs, and Playlists."
                                 Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="rem-primary"
                            Command="{Binding OpenSettingsCommand}"
                            Content="Open Settings"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- Horizontal Shelf 1: Made For You (REM) Personal Mixes -->
                <StackPanel Spacing="8" IsVisible="{Binding HasWebApiAuth}">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="MADE FOR YOU (REM)" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="rem-icon" Tag="HomeMixesShelf" Click="OnShelfScrollLeftClick" Padding="5" Margin="0,0,4,0" ToolTip.Tip="Scroll left">
                      <PathIcon Data="{x:Static svc:IconCatalog.ChevronLeft}" Width="12" Height="12" />
                    </Button>
                    <Button Grid.Column="2" Classes="rem-icon" Tag="HomeMixesShelf" Click="OnShelfScrollRightClick" Padding="5" ToolTip.Tip="Scroll right">
                      <PathIcon Data="{x:Static svc:IconCatalog.ChevronRight}" Width="12" Height="12" />
                    </Button>
                  </Grid>
                  <ScrollViewer x:Name="HomeMixesShelf"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                Padding="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding RemMixCards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RemMixCardViewModel">
                          <Button Command="{Binding OpenCommand}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Cursor="Hand">
                            <Border Classes="rem-card" Width="172" Padding="10">
                              <StackPanel Spacing="8">
                                <!-- Full Spotify-style Cover Artwork (affected by Show Playlist & Mix Cover Icons setting) -->
                                <Border Width="150" Height="150"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{Binding CoverGradientBrush}"
                                        IsVisible="{Binding ShowCoverArt}">
                                  <Grid>
                                    <Image Source="{Binding CoverBitmap}"
                                           Stretch="UniformToFill"
                                           Opacity="0.68"
                                           IsVisible="{Binding HasCoverPhoto}" />
                                    <Border>
                                      <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                          <GradientStop Color="#22000000" Offset="0" />
                                          <GradientStop Color="#B8080A0F" Offset="1" />
                                        </LinearGradientBrush>
                                      </Border.Background>
                                    </Border>
                                    <PathIcon Data="{Binding IconGeometry}"
                                              Width="58" Height="58"
                                              Foreground="{Binding AccentBrush}"
                                              Opacity="0.22"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              Margin="0,10,10,0" />
                                    <Border CornerRadius="4"
                                            Padding="6,2"
                                            Background="{Binding AccentBrush}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="9,9,0,0">
                                      <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{Binding IconGeometry}" Width="10" Height="10" Foreground="#0B0D12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="#0B0D12" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto"
                                          VerticalAlignment="Bottom"
                                          Margin="10,0,10,10">
                                      <TextBlock Grid.Column="0"
                                                 Text="{Binding CoverHeadline}"
                                                 FontSize="16"
                                                 FontWeight="Bold"
                                                 Foreground="#FFFFFF"
                                                 LineHeight="19"
                                                 VerticalAlignment="Bottom" />
                                      <TextBlock Grid.Column="1"
                                                 Text="{Binding CoverBigNumber}"
                                                 FontSize="22"
                                                 FontWeight="Bold"
                                                 Foreground="{Binding AccentBrush}"
                                                 Opacity="0.92"
                                                 VerticalAlignment="Bottom"
                                                 Margin="6,0,0,-2" />
                                    </Grid>
                                    <Border Height="4"
                                            Background="{Binding AccentBrush}"
                                            VerticalAlignment="Bottom" />
                                  </Grid>
                                </Border>

                                <!-- Compact Text Badge Fallback when Cover Icons are disabled -->
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !ShowCoverArt}">
                                  <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Background="{Binding AccentBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <PathIcon Data="{Binding IconGeometry}" Width="11" Height="11" Foreground="#0B0D12" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="#0B0D12" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </Grid>

                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>

                <!-- Horizontal Shelves View (Modern) -->
                <StackPanel Spacing="16" IsVisible="{Binding IsHomeShelvesLayout}">
                  <!-- Horizontal Shelf 2: Recommended Tracks -->
                  <StackPanel Spacing="8" IsVisible="{Binding HasFypTracks}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="RECOMMENDED FOR YOU" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="rem-icon" Tag="HomeRecommendedShelf" Click="OnShelfScrollLeftClick" Padding="5" Margin="0,0,4,0" ToolTip.Tip="Scroll left">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronLeft}" Width="12" Height="12" />
                      </Button>
                      <Button Grid.Column="2" Classes="rem-icon" Tag="HomeRecommendedShelf" Click="OnShelfScrollRightClick" Padding="5" ToolTip.Tip="Scroll right">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronRight}" Width="12" Height="12" />
                      </Button>
                    </Grid>
                    <ScrollViewer x:Name="HomeRecommendedShelf"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,0,0,6">
                      <ItemsControl ItemsSource="{Binding FypTracks}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SpotifyTrackRowViewModel">
                            <Border Classes="rem-card"
                                    Width="168"
                                    Padding="10"
                                    ContextRequested="OnTrackRowContextRequested">
                              <StackPanel Spacing="7">
                                <Border Width="146" Height="116"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        ClipToBounds="True">
                                  <Grid>
                                    <Button Command="{Binding PlayCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                                      <Grid>
                                        <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                        <PathIcon Data="{x:Static svc:IconCatalog.Spotify}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasCover}" />
                                      </Grid>
                                    </Button>
                                    <Button Command="{Binding ToggleLikeCommand}"
                                            Background="#B80E1015"
                                            BorderThickness="0"
                                            CornerRadius="999"
                                            Width="26" Height="26"
                                            Padding="0"
                                            Margin="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding LikeMenuHeader}">
                                      <Grid>
                                        <PathIcon Data="{x:Static svc:IconCatalog.Heart}" Foreground="#1DB954" Width="12" Height="12" IsVisible="{Binding IsLiked}" />
                                        <PathIcon Data="{x:Static svc:IconCatalog.HeartOutline}" Foreground="#FFFFFF" Width="12" Height="12" IsVisible="{Binding !IsLiked}" />
                                      </Grid>
                                    </Button>
                                  </Grid>
                                </Border>
                                <Button Command="{Binding PlayCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artists}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </Button>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>

                  <!-- Horizontal Shelf 3: Your Top Artists -->
                  <StackPanel Spacing="8" IsVisible="{Binding HasHomeTopArtists}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="YOUR TOP ARTISTS" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="rem-icon" Tag="HomeArtistsShelf" Click="OnShelfScrollLeftClick" Padding="5" Margin="0,0,4,0" ToolTip.Tip="Scroll left">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronLeft}" Width="12" Height="12" />
                      </Button>
                      <Button Grid.Column="2" Classes="rem-icon" Tag="HomeArtistsShelf" Click="OnShelfScrollRightClick" Padding="5" ToolTip.Tip="Scroll right">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronRight}" Width="12" Height="12" />
                      </Button>
                    </Grid>
                    <ScrollViewer x:Name="HomeArtistsShelf"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,0,0,6">
                      <ItemsControl ItemsSource="{Binding HomeTopArtists}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SpotifyArtistCardViewModel">
                            <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                              <Border Classes="rem-card" Width="148" Padding="10">
                                <StackPanel Spacing="7" HorizontalAlignment="Center">
                                  <Border Width="82" Height="82" CornerRadius="41" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                                    <Grid>
                                      <Image Source="{Binding PhotoBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasPhoto}" />
                                      <PathIcon Data="{x:Static svc:IconCatalog.Radio}" Foreground="{DynamicResource TextMutedBrush}" Width="22" Height="22" IsVisible="{Binding !HasPhoto}" />
                                    </Grid>
                                  </Border>
                                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>

                  <!-- Horizontal Shelf 4: Recently Played -->
                  <StackPanel Spacing="8" IsVisible="{Binding HasHomeRecentTracks}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="RECENTLY PLAYED" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="rem-icon" Tag="HomeRecentShelf" Click="OnShelfScrollLeftClick" Padding="5" Margin="0,0,4,0" ToolTip.Tip="Scroll left">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronLeft}" Width="12" Height="12" />
                      </Button>
                      <Button Grid.Column="2" Classes="rem-icon" Tag="HomeRecentShelf" Click="OnShelfScrollRightClick" Padding="5" ToolTip.Tip="Scroll right">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronRight}" Width="12" Height="12" />
                      </Button>
                    </Grid>
                    <ScrollViewer x:Name="HomeRecentShelf"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,0,0,6">
                      <ItemsControl ItemsSource="{Binding HomeRecentTracks}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SpotifyTrackRowViewModel">
                            <Border Classes="rem-card"
                                    Width="168"
                                    Padding="10"
                                    ContextRequested="OnTrackRowContextRequested">
                              <StackPanel Spacing="7">
                                <Border Width="146" Height="116"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        ClipToBounds="True">
                                  <Grid>
                                    <Button Command="{Binding PlayCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                                      <Grid>
                                        <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                        <PathIcon Data="{x:Static svc:IconCatalog.Spotify}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasCover}" />
                                      </Grid>
                                    </Button>
                                    <Button Command="{Binding ToggleLikeCommand}"
                                            Background="#B80E1015"
                                            BorderThickness="0"
                                            CornerRadius="999"
                                            Width="26" Height="26"
                                            Padding="0"
                                            Margin="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding LikeMenuHeader}">
                                      <Grid>
                                        <PathIcon Data="{x:Static svc:IconCatalog.Heart}" Foreground="#1DB954" Width="12" Height="12" IsVisible="{Binding IsLiked}" />
                                        <PathIcon Data="{x:Static svc:IconCatalog.HeartOutline}" Foreground="#FFFFFF" Width="12" Height="12" IsVisible="{Binding !IsLiked}" />
                                      </Grid>
                                    </Button>
                                  </Grid>
                                </Border>
                                <Button Command="{Binding PlayCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artists}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </Button>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>

                  <!-- Horizontal Shelf 5: Albums For You -->
                  <StackPanel Spacing="8" IsVisible="{Binding HasHomeAlbums}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="ALBUMS FOR YOU" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="rem-icon" Tag="HomeAlbumsShelf" Click="OnShelfScrollLeftClick" Padding="5" Margin="0,0,4,0" ToolTip.Tip="Scroll left">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronLeft}" Width="12" Height="12" />
                      </Button>
                      <Button Grid.Column="2" Classes="rem-icon" Tag="HomeAlbumsShelf" Click="OnShelfScrollRightClick" Padding="5" ToolTip.Tip="Scroll right">
                        <PathIcon Data="{x:Static svc:IconCatalog.ChevronRight}" Width="12" Height="12" />
                      </Button>
                    </Grid>
                    <ScrollViewer x:Name="HomeAlbumsShelf"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,0,0,6">
                      <ItemsControl ItemsSource="{Binding HomeAlbums}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SpotifyAlbumCardViewModel">
                            <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                              <Border Classes="rem-card" Width="162" Padding="10">
                                <StackPanel Spacing="7">
                                  <Border Width="140" Height="112" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                                    <Grid>
                                      <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                      <PathIcon Data="{x:Static svc:IconCatalog.Disc}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasCover}" />
                                    </Grid>
                                  </Border>
                                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>

                <!-- Classic List View (Old Style · Lowest RAM) -->
                <StackPanel Spacing="8" IsVisible="{Binding IsHomeClassicLayout}">
                  <TextBlock Text="RECOMMENDED FOR YOU" Classes="muted" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding HasFypTracks}" />
                  <ItemsControl ItemsSource="{Binding FypTracks}"
                                Opacity="{Binding ListFadeOpacity}"
                                ItemTemplate="{StaticResource SpotifyTrackRowTemplate}">
                    <ItemsControl.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                      </Transitions>
                    </ItemsControl.Transitions>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- SECTION: MULTI-SEARCH RESULTS -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSearchSection}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Search Results" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsSearchFilterAll}" Command="{Binding SetSearchFilterCommand}" CommandParameter="All" Content="All" Padding="10,5" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsSearchFilterTracks}" Command="{Binding SetSearchFilterCommand}" CommandParameter="Tracks" Content="Songs" Padding="10,5" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsSearchFilterArtists}" Command="{Binding SetSearchFilterCommand}" CommandParameter="Artists" Content="Artists" Padding="10,5" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsSearchFilterAlbums}" Command="{Binding SetSearchFilterCommand}" CommandParameter="Albums" Content="Albums" Padding="10,5" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsSearchFilterPlaylists}" Command="{Binding SetSearchFilterCommand}" CommandParameter="Playlists" Content="Playlists" Padding="10,5" FontSize="11" />
                  </StackPanel>
                </Grid>

                <Border Classes="rem-card" Padding="14" IsVisible="{Binding HasFeedMessage}">
                  <TextBlock Text="{Binding FeedMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Artists -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowSearchArtistsSection}">
                  <TextBlock Text="ARTISTS" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding SearchArtists}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:SpotifyArtistCardViewModel">
                        <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand">
                          <Border Classes="rem-card" Width="154" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                              <Border Width="86" Height="86" CornerRadius="43" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                                <Grid>
                                  <Image Source="{Binding PhotoBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasPhoto}" />
                                  <PathIcon Data="{x:Static svc:IconCatalog.Radio}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasPhoto}" />
                                </Grid>
                              </Border>
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Albums -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowSearchAlbumsSection}">
                  <TextBlock Text="ALBUMS" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding SearchAlbums}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:SpotifyAlbumCardViewModel">
                        <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand">
                          <Border Classes="rem-card" Width="162" Padding="10">
                            <StackPanel Spacing="7">
                              <Border Width="140" Height="112" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                                <Grid>
                                  <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                  <PathIcon Data="{x:Static svc:IconCatalog.Disc}" Foreground="{DynamicResource TextMutedBrush}" Width="26" Height="26" IsVisible="{Binding !HasCover}" />
                                </Grid>
                              </Border>
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Playlists -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowSearchPlaylistsSection}">
                  <TextBlock Text="PLAYLISTS" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding SearchPlaylists}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:SpotifyPlaylistCardViewModel">
                        <Border Classes="rem-card" Width="168" Padding="10" Margin="0,0,10,10">
                          <StackPanel Spacing="7">
                            <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                              <StackPanel Spacing="7">
                                <Border Width="146" Height="106" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                                  <Grid>
                                    <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                    <PathIcon Data="{x:Static svc:IconCatalog.MusicNote}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasCover}" />
                                  </Grid>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                            <Grid ColumnDefinitions="*,*">
                              <Button Grid.Column="0" Classes="rem-soft" Command="{Binding PlayCommand}" Content="Play" Padding="6,4" FontSize="10" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                              <Button Grid.Column="1" Classes="rem-soft" Command="{Binding FollowCommand}" Content="Save" Padding="6,4" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Songs -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowSearchTracksSection}">
                  <TextBlock Text="SONGS" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding SearchTracks}"
                                ItemTemplate="{StaticResource SpotifyTrackRowTemplate}" />
                </StackPanel>
              </StackPanel>

              <!-- SECTION: ARTIST PROFILE -->
              <StackPanel Spacing="14" IsVisible="{Binding IsArtistProfileSection}">
                <Border Classes="rem-card" Padding="16">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="48" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" Margin="0,0,16,0" VerticalAlignment="Center">
                      <Grid>
                        <Image Source="{Binding ActiveArtistBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasActiveArtistBitmap}" />
                        <PathIcon Data="{x:Static svc:IconCatalog.Radio}" Foreground="{DynamicResource TextMutedBrush}" Width="28" Height="28" IsVisible="{Binding !HasActiveArtistBitmap}" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="ARTIST" Classes="muted" FontSize="10" FontWeight="Bold" />
                      <TextBlock Text="{Binding ActiveArtistName}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ActiveArtistSubtitle}" Classes="muted" FontSize="12" />
                      <ItemsControl ItemsSource="{Binding ActiveArtistTags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="x:String">
                            <Border CornerRadius="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="7,2" Margin="0,0,6,4">
                              <TextBlock Text="{Binding .}" Classes="muted" FontSize="10" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="rem-primary" Command="{Binding PlayActiveCollectionCommand}" Content="Play Top Tracks" />
                        <Button Classes="rem-soft" Command="{Binding StartActiveArtistRadioCommand}" Content="Artist Radio" />
                        <Button Classes="rem-soft" Command="{Binding ToggleFollowActiveArtistCommand}" Content="{Binding ArtistFollowLabel}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="rem-card" Padding="14" IsVisible="{Binding HasActiveArtistBio}">
                  <TextBlock Text="{Binding ActiveArtistBio}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                </Border>

                <Border Classes="rem-card" Padding="14" IsVisible="{Binding HasFeedMessage}">
                  <TextBlock Text="{Binding FeedMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="TOP TRACKS" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding DetailTracks}"
                              Opacity="{Binding ListFadeOpacity}"
                              ItemTemplate="{StaticResource SpotifyTrackRowTemplate}">
                  <ItemsControl.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    </Transitions>
                  </ItemsControl.Transitions>
                </ItemsControl>

                <TextBlock Text="ALBUMS &amp; SINGLES" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ArtistAlbums}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyAlbumCardViewModel">
                      <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand">
                        <Border Classes="rem-card" Width="162" Padding="10">
                          <StackPanel Spacing="7">
                            <Border Width="140" Height="112" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                              <Grid>
                                <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                <PathIcon Data="{x:Static svc:IconCatalog.Disc}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasCover}" />
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="FANS ALSO LIKE" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SimilarArtists}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyArtistCardViewModel">
                      <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand">
                        <Border Classes="rem-card" Width="146" Padding="10">
                          <StackPanel Spacing="7" HorizontalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                              <Grid>
                                <Image Source="{Binding PhotoBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasPhoto}" />
                                <PathIcon Data="{x:Static svc:IconCatalog.Radio}" Foreground="{DynamicResource TextMutedBrush}" Width="22" Height="22" IsVisible="{Binding !HasPhoto}" />
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- SECTION: ALBUM DETAIL -->
              <StackPanel Spacing="14" IsVisible="{Binding IsAlbumDetailSection}">
                <Border Classes="rem-card" Padding="16">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="104" Height="104" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" Margin="0,0,16,0">
                      <Grid>
                        <Image Source="{Binding ActiveAlbumBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasActiveAlbumBitmap}" />
                        <PathIcon Data="{x:Static svc:IconCatalog.Disc}" Foreground="{DynamicResource TextMutedBrush}" Width="28" Height="28" IsVisible="{Binding !HasActiveAlbumBitmap}" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="ALBUM" Classes="muted" FontSize="10" FontWeight="Bold" />
                      <TextBlock Text="{Binding ActiveAlbumTitle}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <Button Command="{Binding OpenActiveAlbumArtistCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand">
                        <TextBlock Text="{Binding ActiveAlbumSubtitle}" Classes="muted" FontSize="12" />
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="rem-primary" Command="{Binding PlayActiveCollectionCommand}" Content="Play Album" />
                        <Button Classes="rem-soft" Command="{Binding ToggleSaveActiveAlbumCommand}" Content="{Binding AlbumSaveLabel}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding DetailTracks}"
                              Opacity="{Binding ListFadeOpacity}"
                              ItemTemplate="{StaticResource SpotifyTrackRowTemplate}">
                  <ItemsControl.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    </Transitions>
                  </ItemsControl.Transitions>
                </ItemsControl>
              </StackPanel>

              <!-- SECTION: SAVED ALBUMS -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSavedAlbumsSection}">
                <TextBlock Text="Saved Albums" FontSize="20" FontWeight="SemiBold" />
                <Border Classes="rem-card" Padding="14" IsVisible="{Binding HasFeedMessage}">
                  <TextBlock Text="{Binding FeedMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding SavedAlbums}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyAlbumCardViewModel">
                      <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand">
                        <Border Classes="rem-card" Width="166" Padding="10">
                          <StackPanel Spacing="7">
                            <Border Width="144" Height="114" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                              <Grid>
                                <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                <PathIcon Data="{x:Static svc:IconCatalog.Disc}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasCover}" />
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- SECTION: TOP ARTISTS -->
              <StackPanel Spacing="14" IsVisible="{Binding IsTopArtistsSection}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Your Top Artists" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsTopRangeShort}" Command="{Binding SetTopArtistsRangeCommand}" CommandParameter="short_term" Content="4 Weeks" Padding="10,5" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsTopRangeMedium}" Command="{Binding SetTopArtistsRangeCommand}" CommandParameter="medium_term" Content="6 Months" Padding="10,5" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsTopRangeLong}" Command="{Binding SetTopArtistsRangeCommand}" CommandParameter="long_term" Content="All Time" Padding="10,5" FontSize="11" />
                  </StackPanel>
                </Grid>

                <Border Classes="rem-card" Padding="14" IsVisible="{Binding HasFeedMessage}">
                  <TextBlock Text="{Binding FeedMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding TopArtists}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyArtistCardViewModel">
                      <Button Command="{Binding OpenCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10" Cursor="Hand">
                        <Border Classes="rem-card" Width="156" Padding="12">
                          <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="86" Height="86" CornerRadius="43" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                              <Grid>
                                <Image Source="{Binding PhotoBitmap}" Stretch="UniformToFill" IsVisible="{Binding HasPhoto}" />
                                <PathIcon Data="{x:Static svc:IconCatalog.Radio}" Foreground="{DynamicResource TextMutedBrush}" Width="24" Height="24" IsVisible="{Binding !HasPhoto}" />
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- SECTION: REM MIX / SONG RADIO / ARTIST RADIO -->
              <StackPanel Spacing="14" IsVisible="{Binding IsRemMixSection}">
                <Border Classes="rem-card" Padding="14">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Column="0"
                            Width="96" Height="96"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,0,16,0"
                            Background="{Binding ActiveMixCoverGradientBrush}"
                            IsVisible="{Binding ShowPlaylistIcons}">
                      <Grid>
                        <Image Source="{Binding ActiveMixCoverBitmap}"
                               Stretch="UniformToFill"
                               Opacity="0.68"
                               IsVisible="{Binding HasActiveMixCoverBitmap}" />
                        <Border>
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                              <GradientStop Color="#20000000" Offset="0" />
                              <GradientStop Color="#AA080A0F" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <PathIcon Data="{Binding ActiveMixIconGeometry}"
                                  Width="36" Height="36"
                                  Foreground="{Binding ActiveMixAccentBrush}"
                                  Opacity="0.28"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0,8,8,0" />
                        <TextBlock Text="{Binding ActiveMixCoverBigNumber}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{Binding ActiveMixAccentBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="9,0,0,8" />
                        <Border Height="3"
                                Background="{Binding ActiveMixAccentBrush}"
                                VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{Binding ActiveMixIconGeometry}" Foreground="{Binding ActiveMixAccentBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveMixBadge}" Foreground="{Binding ActiveMixAccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding ActiveMixTitle}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ActiveMixSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="rem-soft" Command="{Binding RefreshActiveMixCommand}" IsEnabled="{Binding !IsBusy}" Content="Regenerate" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="rem-soft" Command="{Binding SaveActiveMixToSpotifyCommand}" IsEnabled="{Binding !IsBusy}" Content="Save to Spotify" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Classes="rem-primary" Command="{Binding PlayActiveCollectionCommand}" Content="Play All" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Classes="rem-card" Padding="14" IsVisible="{Binding HasFeedMessage}">
                  <TextBlock Text="{Binding FeedMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding DetailTracks}"
                              Opacity="{Binding ListFadeOpacity}"
                              ItemTemplate="{StaticResource SpotifyTrackRowTemplate}">
                  <ItemsControl.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    </Transitions>
                  </ItemsControl.Transitions>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Virtualized Liked Songs / Playlist View -->
          <Grid Grid.Row="3"
                RowDefinitions="Auto,Auto,Auto,*"
                Margin="18,14,18,12"
                IsVisible="{Binding IsCollectionSection}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
              <StackPanel Spacing="2" Margin="0,0,12,0">
                <TextBlock Text="{Binding CollectionTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding CollectionSubtitle}" Classes="muted" FontSize="12" />
                  <TextBlock Text="{Binding CollectionPaginationStatus}"
                             Foreground="{DynamicResource PrimaryAccentBrush}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasCollectionPaginationStatus}" />
                </StackPanel>
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="rem-soft"
                      Command="{Binding OpenEditActivePlaylistModalCommand}"
                      IsVisible="{Binding IsActivePlaylistEditable}"
                      Content="Edit"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center" />

              <Button Grid.Column="2"
                      Classes="rem-danger"
                      Command="{Binding DeleteActivePlaylistCommand}"
                      IsVisible="{Binding IsActivePlaylistEditable}"
                      Content="Remove"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center" />

              <Button Grid.Column="3"
                      Classes="rem-primary"
                      Command="{Binding PlayActiveCollectionCommand}"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{x:Static svc:IconCatalog.Play}" Foreground="{DynamicResource TextOnAccentBrush}" Width="13" Height="13" />
                  <TextBlock Text="Play All" Foreground="{DynamicResource TextOnAccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- Search Inside Playlist / Liked Songs -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <Border Grid.Column="0"
                      Background="{DynamicResource SurfaceAltBrush}"
                      BorderBrush="{DynamicResource BorderSoftBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10,4">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Grid.Column="0"
                            Data="{x:Static svc:IconCatalog.Search}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Width="13" Height="13"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding CollectionFilterQuery}"
                           Watermark="Search in this playlist (title, artist, album)..."
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="0,3"
                           FontSize="12"
                           VerticalAlignment="Center" />
                  <Button Grid.Column="2"
                          Classes="rem-icon"
                          Command="{Binding ClearCollectionFilterCommand}"
                          IsVisible="{Binding HasCollectionFilter}"
                          ToolTip.Tip="Clear playlist filter"
                          Padding="4">
                    <PathIcon Data="{x:Static svc:IconCatalog.Close}" Width="11" Height="11" />
                  </Button>
                </Grid>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding CollectionFilterSummary}"
                         Classes="muted"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         IsVisible="{Binding HasCollectionFilter}" />
            </Grid>

            <Border Grid.Row="2" Classes="rem-card" Padding="14" Margin="0,0,0,10" IsVisible="{Binding HasFeedMessage}">
              <TextBlock Text="{Binding FeedMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="3"
                    Classes="rem-card"
                    Padding="24"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowCollectionLoadingPlaceholder}">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Loading tracks..." FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Fetching playlist tracks from Spotify" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <ListBox Grid.Row="3"
                     Classes="virtual-tracks"
                     ItemsSource="{Binding CollectionTracks}"
                     Opacity="{Binding ListFadeOpacity}"
                     ItemTemplate="{StaticResource SpotifyTrackRowTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0,0,0,28"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
              </ListBox.Transitions>
            </ListBox>
          </Grid>

          <!-- Rem Companion Sitting Above Player (Bottom-Right of Song List, Left of Lyrics) -->
          <Image Grid.Row="3"
                 Source="{Binding RemCompanionBitmap}"
                 Stretch="Uniform"
                 MaxHeight="152"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,10,0"
                 IsHitTestVisible="False"
                 IsVisible="{Binding ShowRemCompanion}" />
        </Grid>

        <!-- Toggleable Right Drawer: Synced Lyrics & Up Next / Queue -->
        <Border Grid.Column="2"
                Width="316"
                IsVisible="{Binding IsDrawerOpen}"
                Background="{Binding LyricsDrawerBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1,0,0,0">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
              <Grid ColumnDefinitions="*,*,Auto">
                <Button Grid.Column="0"
                        Classes="sidebar-tab"
                        Classes.active="{Binding IsLyricsDrawerActive}"
                        Command="{Binding SelectLyricsTabCommand}"
                        Margin="0,0,4,0">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <PathIcon Data="{x:Static svc:IconCatalog.Lyrics}" Width="13" Height="13" />
                    <TextBlock Text="Lyrics" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Classes="sidebar-tab"
                        Classes.active="{Binding IsQueueDrawerActive}"
                        Command="{Binding SelectQueueTabCommand}"
                        Margin="0,0,4,0">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <PathIcon Data="{x:Static svc:IconCatalog.QueueList}" Width="13" Height="13" />
                    <TextBlock Text="Queue" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Classes="rem-icon"
                        Command="{Binding ToggleLyricsDrawerCommand}"
                        ToolTip.Tip="Close drawer">
                  <PathIcon Data="{x:Static svc:IconCatalog.Close}" Width="12" Height="12" />
                </Button>
              </Grid>
            </Border>

            <!-- Synced Lyrics Pane -->
            <ScrollViewer Grid.Row="1"
                          x:Name="LyricsScrollViewer"
                          IsVisible="{Binding IsLyricsDrawerActive}"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="14,12,14,18">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding LyricsStatusText}"
                             Classes="muted"
                             FontSize="11"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                  <Button Grid.Column="1"
                          Classes="rem-icon"
                          Command="{Binding RetryLyricsCommand}"
                          ToolTip.Tip="Retry / refresh lyrics"
                          Margin="0,0,2,0">
                    <PathIcon Data="{x:Static svc:IconCatalog.Refresh}" Width="12" Height="12" />
                  </Button>
                  <Button Grid.Column="2"
                          Classes="rem-icon"
                          Command="{Binding ToggleLyricsSearchCommand}"
                          ToolTip.Tip="Search or pick alternate lyrics"
                          Margin="0,0,2,0">
                    <PathIcon Data="{x:Static svc:IconCatalog.Search}" Width="12" Height="12" />
                  </Button>
                  <Button Grid.Column="3"
                          Classes="sidebar-tab"
                          Classes.active="{Binding IsLyricsStyleOpen}"
                          Command="{Binding ToggleLyricsStyleCommand}"
                          ToolTip.Tip="Customize Lyrics Style &amp; Animations"
                          Padding="6,4"
                          Margin="0,0,2,0">
                    <PathIcon Data="{x:Static svc:IconCatalog.Settings}" Width="12" Height="12" />
                  </Button>
                  <Button Grid.Column="4"
                          Classes="rem-icon"
                          Command="{Binding ToggleLyricsFullscreenCommand}"
                          ToolTip.Tip="Fullscreen Lyrics">
                    <PathIcon Data="{x:Static svc:IconCatalog.Fullscreen}" Width="12" Height="12" />
                  </Button>
                </Grid>

                <!-- Lyrics Appearance Controls Card -->
                <Border Classes="rem-card"
                        Padding="10"
                        IsVisible="{Binding IsLyricsStyleOpen}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="LYRICS STYLE" Classes="muted" FontSize="10" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,*,*">
                      <Button Grid.Column="0" Classes="sidebar-tab" Classes.active="{Binding IsLyricsBgAmbient}" Command="{Binding SetLyricsBgModeCommand}" CommandParameter="Ambient" Content="Ambient" Padding="6,4" FontSize="10" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Grid.Column="1" Classes="sidebar-tab" Classes.active="{Binding IsLyricsBgSolid}" Command="{Binding SetLyricsBgModeCommand}" CommandParameter="Solid" Content="Solid" Padding="6,4" FontSize="10" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Grid.Column="2" Classes="sidebar-tab" Classes.active="{Binding IsLyricsBgAlbumTint}" Command="{Binding SetLyricsBgModeCommand}" CommandParameter="AlbumTint" Content="Tint" Padding="6,4" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding IsLyricsBgSolid}">
                      <ItemsControl ItemsSource="{Binding LyricsColorSwatches}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:LyricsColorSwatchViewModel">
                            <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0" Padding="2" Cursor="Hand" ToolTip.Tip="{Binding Name}">
                              <Border Width="20" Height="20" CornerRadius="10" Background="{Binding ColorBrush}" BorderBrush="#88FFFFFF" BorderThickness="1" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Classes="rem" FontSize="11" Padding="7,4" Watermark="#0B0D14" Text="{Binding LyricsSolidColorHex}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Classes="rem-soft" Command="{Binding ApplyCustomLyricsColorCommand}" Content="Set" Padding="9,4" FontSize="11" />
                      </Grid>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                      <CheckBox Content="Timestamps" IsChecked="{Binding LyricsShowTimestamps}" FontSize="11" Margin="0,0,10,4" />
                      <CheckBox Content="Animations" IsChecked="{Binding LyricsAnimate}" FontSize="11" Margin="0,0,10,4" />
                      <CheckBox Content="Center" IsChecked="{Binding LyricsCentered}" FontSize="11" Margin="0,0,0,4" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="Text Size" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <Slider Grid.Column="1" Minimum="12" Maximum="22" Value="{Binding LyricsFontSize}" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Manual Lyrics Search & Picker -->
                <Border Classes="rem-card"
                        Padding="10"
                        IsVisible="{Binding IsLyricsSearchOpen}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0"
                               Classes="rem"
                               Watermark="Artist &amp; song title..."
                               Text="{Binding LyricsSearchQuery}"
                               FontSize="12"
                               Margin="0,0,6,0">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SearchLyricsManualCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button Grid.Column="1"
                              Classes="rem-primary"
                              Command="{Binding SearchLyricsManualCommand}"
                              Content="Find"
                              Padding="10,6"
                              FontSize="11" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding LyricsSearchResults}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SpotifyLyricCandidateRowViewModel">
                          <Button Command="{Binding SelectCommand}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Margin="0,0,0,4"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Cursor="Hand">
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,6,0">
                                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        CornerRadius="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Padding="5,2"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Badge}" Classes="muted" FontSize="9" FontWeight="Bold" />
                                </Border>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Sync Timing Controls (Click-to-Sync & Nudge) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsSyncedLyrics}">
                  <Border Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource BorderSoftBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="6,5">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                      <Button Grid.Column="0"
                              Classes="rem-soft"
                              Command="{Binding NudgeLyricsOffsetCommand}"
                              CommandParameter="-500"
                              Content="-0.5"
                              Padding="6,3"
                              FontSize="10"
                              ToolTip.Tip="Shift lyrics 0.5s earlier"
                              Margin="0,0,3,0" />
                      <Button Grid.Column="1"
                              Classes="rem-soft"
                              Command="{Binding NudgeLyricsOffsetCommand}"
                              CommandParameter="-100"
                              Content="-0.1"
                              Padding="6,3"
                              FontSize="10"
                              ToolTip.Tip="Shift lyrics 0.1s earlier" />
                      <Button Grid.Column="2"
                              Command="{Binding ResetLyricsOffsetCommand}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4,2"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="Reset lyrics offset to 0.0s"
                              Cursor="Hand">
                        <TextBlock Text="{Binding LyricsOffsetDisplay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Button>
                      <Button Grid.Column="3"
                              Classes="rem-soft"
                              Command="{Binding NudgeLyricsOffsetCommand}"
                              CommandParameter="100"
                              Content="+0.1"
                              Padding="6,3"
                              FontSize="10"
                              ToolTip.Tip="Shift lyrics 0.1s later"
                              Margin="0,0,3,0" />
                      <Button Grid.Column="4"
                              Classes="rem-soft"
                              Command="{Binding NudgeLyricsOffsetCommand}"
                              CommandParameter="500"
                              Content="+0.5"
                              Padding="6,3"
                              FontSize="10"
                              ToolTip.Tip="Shift lyrics 0.5s later"
                              Margin="0,0,4,0" />
                      <Button Grid.Column="5"
                              Classes="sidebar-tab"
                              Classes.active="{Binding IsSyncPickMode}"
                              Command="{Binding ToggleSyncPickModeCommand}"
                              Content="{Binding SyncPickButtonText}"
                              Padding="7,3"
                              FontSize="10"
                              FontWeight="SemiBold"
                              ToolTip.Tip="Click a lyric line below to sync it to the current playback time" />
                    </Grid>
                  </Border>

                  <TextBlock Text="Click the line being sung right now to sync timing"
                             Foreground="{DynamicResource PrimaryAccentBrush}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             IsVisible="{Binding IsSyncPickMode}" />
                </StackPanel>

                <ItemsControl x:Name="LyricsItemsControl"
                              ItemsSource="{Binding LyricLines}"
                              IsVisible="{Binding IsSyncedLyrics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyLyricLineViewModel">
                      <Button Command="{Binding ClickCommand}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              ToolTip.Tip="{Binding TimestampDisplay, StringFormat='Click to jump or sync ({0})'}"
                              Cursor="Hand">
                        <Border Classes="lyric-line"
                                Classes.active="{Binding IsActive}"
                                Classes.past="{Binding IsPast}"
                                Classes.animated="{Binding IsLyricsAnimated}"
                                Padding="8,6"
                                Margin="0,0,0,2">
                          <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimestampDisplay}"
                                       Classes="muted"
                                       FontSize="10"
                                       Width="34"
                                       Opacity="0.48"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       IsVisible="{Binding ShowTimestamp}" />
                            <TextBlock Grid.Column="1"
                                       Classes="lyric-text"
                                       Classes.animated="{Binding IsLyricsAnimated}"
                                       Text="{Binding Text}"
                                       FontSize="{Binding DrawerFontSize}"
                                       TextAlignment="{Binding LineTextAlignment}"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding PlainLyrics}"
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasPlainLyrics}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Up Next / Queue Pane -->
            <ScrollViewer Grid.Row="1"
                          IsVisible="{Binding IsQueueDrawerActive}"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="8" Margin="14,12,14,18">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Up Next" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Classes="rem-icon"
                          Command="{Binding RefreshQueueCommand}"
                          ToolTip.Tip="Refresh Queue">
                    <PathIcon Data="{x:Static svc:IconCatalog.Refresh}" Width="12" Height="12" />
                  </Button>
                </Grid>

                <TextBlock Text="{Binding QueueStatusText}"
                           Classes="muted"
                           FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasQueueEntries}" />

                <ItemsControl ItemsSource="{Binding QueueEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyQueueRowViewModel">
                      <Button Command="{Binding PlayCommand}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Cursor="Hand">
                        <Border Classes="rem-card" Padding="10,8">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Artists}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="4"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Padding="5,2"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding ProviderLabel}" Classes="muted" FontSize="9" FontWeight="SemiBold" />
                            </Border>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Floating Toast Pill -->
      <Border Grid.Row="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,18,12"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,7"
              IsHitTestVisible="False"
              IsVisible="{Binding HasToastMessage}">
        <TextBlock Text="{Binding ToastMessage}" FontSize="12" FontWeight="SemiBold" />
      </Border>

      <!-- Inline Create / Edit Playlist Modal Overlay -->
      <Border Grid.Row="0"
              Grid.RowSpan="2"
              Background="#B8080A10"
              IsVisible="{Binding IsPlaylistModalOpen}">
        <Border Classes="rem-card"
                Width="390"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding PlaylistModalTitleText}" FontSize="17" FontWeight="Bold" />

            <StackPanel Spacing="4">
              <TextBlock Text="Name" Classes="muted" FontSize="11" />
              <TextBox Classes="rem" Watermark="My awesome playlist..." Text="{Binding PlaylistModalName}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Description (optional)" Classes="muted" FontSize="11" />
              <TextBox Classes="rem" Watermark="A little description..." Text="{Binding PlaylistModalDescription}" />
            </StackPanel>

            <CheckBox Content="Make playlist public" IsChecked="{Binding PlaylistModalIsPublic}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
              <Button Classes="rem-soft" Command="{Binding CancelPlaylistModalCommand}" Content="Cancel" />
              <Button Classes="rem-primary" Command="{Binding SubmitPlaylistModalCommand}" Content="Save" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- Fullscreen Lyrics Stage Overlay (full height behind auto-hiding Player Bar) -->
      <Border Grid.Row="0"
              Grid.RowSpan="3"
              Background="{Binding LyricsFullscreenBackgroundBrush}"
              IsVisible="{Binding IsLyricsFullscreen}">
        <Grid>
          <Border IsHitTestVisible="False"
                  Background="{Binding EffectiveAmbientGlowBrush}"
                  IsVisible="{Binding IsLyricsBgAmbient}" />

          <Grid RowDefinitions="Auto,Auto,*">
            <!-- Top Fullscreen Controls -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceAltBrush}"
                        ClipToBounds="True"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                  <Grid>
                    <Image Source="{Binding CurrentAlbumArt}" Stretch="UniformToFill" IsVisible="{Binding HasCurrentAlbumArt}" />
                    <PathIcon Data="{x:Static svc:IconCatalog.Spotify}"
                              Foreground="{DynamicResource PrimaryAccentBrush}"
                              Width="20" Height="20"
                              IsVisible="{Binding !HasCurrentAlbumArt}" />
                  </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="{Binding CurrentTrackTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding CurrentTrackArtist}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Sync Bar inside Fullscreen -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,5"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSyncedLyrics}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="rem-soft" Command="{Binding NudgeLyricsOffsetCommand}" CommandParameter="-500" Content="-0.5" Padding="7,3" FontSize="11" />
                    <Button Classes="rem-soft" Command="{Binding NudgeLyricsOffsetCommand}" CommandParameter="-100" Content="-0.1" Padding="7,3" FontSize="11" />
                    <Button Command="{Binding ResetLyricsOffsetCommand}" Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand">
                      <TextBlock Text="{Binding LyricsOffsetDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                    <Button Classes="rem-soft" Command="{Binding NudgeLyricsOffsetCommand}" CommandParameter="100" Content="+0.1" Padding="7,3" FontSize="11" />
                    <Button Classes="rem-soft" Command="{Binding NudgeLyricsOffsetCommand}" CommandParameter="500" Content="+0.5" Padding="7,3" FontSize="11" />
                    <Button Classes="sidebar-tab" Classes.active="{Binding IsSyncPickMode}" Command="{Binding ToggleSyncPickModeCommand}" Content="{Binding SyncPickButtonText}" Padding="9,3" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" />
                  </StackPanel>
                </Border>

                <Button Grid.Column="3"
                        Classes="sidebar-tab"
                        Classes.active="{Binding IsLyricsStyleOpen}"
                        Command="{Binding ToggleLyricsStyleCommand}"
                        ToolTip.Tip="Customize Lyrics Background, Font &amp; Animations"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{x:Static svc:IconCatalog.Settings}" Width="13" Height="13" />
                    <TextBlock Text="Style" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Classes="rem-soft"
                        Command="{Binding CloseLyricsFullscreenCommand}"
                        ToolTip.Tip="Exit Fullscreen Lyrics (Esc)"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{x:Static svc:IconCatalog.ExitFullscreen}" Width="14" Height="14" />
                    <TextBlock Text="Exit Fullscreen" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- Fullscreen Lyrics Style Drawer Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,10"
                    IsVisible="{Binding IsLyricsStyleOpen}">
              <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center">
                  <TextBlock Text="Background:" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <Button Classes="sidebar-tab" Classes.active="{Binding IsLyricsBgAmbient}" Command="{Binding SetLyricsBgModeCommand}" CommandParameter="Ambient" Content="Ambient" Padding="9,4" FontSize="11" />
                  <Button Classes="sidebar-tab" Classes.active="{Binding IsLyricsBgSolid}" Command="{Binding SetLyricsBgModeCommand}" CommandParameter="Solid" Content="Solid" Padding="9,4" FontSize="11" />
                  <Button Classes="sidebar-tab" Classes.active="{Binding IsLyricsBgAlbumTint}" Command="{Binding SetLyricsBgModeCommand}" CommandParameter="AlbumTint" Content="Album Tint" Padding="9,4" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsVisible="{Binding IsLyricsBgSolid}">
                  <ItemsControl ItemsSource="{Binding LyricsColorSwatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:LyricsColorSwatchViewModel">
                        <Button Command="{Binding SelectCommand}" Background="Transparent" BorderThickness="0" Padding="1" Cursor="Hand" ToolTip.Tip="{Binding Name}">
                          <Border Width="20" Height="20" CornerRadius="10" Background="{Binding ColorBrush}" BorderBrush="#88FFFFFF" BorderThickness="1" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Classes="rem" Width="82" FontSize="11" Padding="6,3" Watermark="#0B0D14" Text="{Binding LyricsSolidColorHex}" />
                  <Button Classes="rem-soft" Command="{Binding ApplyCustomLyricsColorCommand}" Content="Set" Padding="8,4" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,18,2" VerticalAlignment="Center">
                  <CheckBox Content="Timestamps" IsChecked="{Binding LyricsShowTimestamps}" FontSize="11" />
                  <CheckBox Content="Smooth Animations" IsChecked="{Binding LyricsAnimate}" FontSize="11" />
                  <CheckBox Content="Center Text" IsChecked="{Binding LyricsCentered}" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2" VerticalAlignment="Center">
                  <TextBlock Text="Size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <Slider Minimum="12" Maximum="22" Value="{Binding LyricsFontSize}" Width="90" VerticalAlignment="Center" />
                </StackPanel>
              </WrapPanel>
            </Border>

            <!-- Centered Large Sing-Along Lyrics -->
            <ScrollViewer Grid.Row="2"
                          x:Name="FullscreenLyricsScrollViewer"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" MaxWidth="780" HorizontalAlignment="Center" Margin="32,28,32,48">
                <TextBlock Text="{Binding LyricsStatusText}"
                           Classes="muted"
                           FontSize="12"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Click the line being sung right now to sync timing"
                           Foreground="{DynamicResource PrimaryAccentBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsSyncPickMode}" />

                <ItemsControl x:Name="FullscreenLyricsItemsControl"
                              ItemsSource="{Binding FullscreenLyricLines}"
                              IsVisible="{Binding IsSyncedLyrics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SpotifyLyricLineViewModel">
                      <Button Command="{Binding ClickCommand}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Cursor="Hand">
                        <Border Classes="lyric-line"
                                Classes.active="{Binding IsActive}"
                                Classes.past="{Binding IsPast}"
                                Classes.animated="{Binding IsLyricsAnimated}"
                                Padding="16,10"
                                Margin="12,0,12,4">
                          <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimestampDisplay}"
                                       Classes="muted"
                                       FontSize="12"
                                       Width="44"
                                       Opacity="0.48"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       IsVisible="{Binding ShowTimestamp}" />
                            <TextBlock Grid.Column="1"
                                       Classes="lyric-text"
                                       Classes.animated="{Binding IsLyricsAnimated}"
                                       Text="{Binding Text}"
                                       FontSize="{Binding FullscreenFontSize}"
                                       TextAlignment="{Binding LineTextAlignment}"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding PlainLyrics}"
                           FontSize="18"
                           LineHeight="28"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           IsVisible="{Binding HasPlainLyrics}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- Bottom hover zone to reveal the player bar when auto-hidden in Fullscreen Lyrics mode -->
      <Border x:Name="LyricsPlayerHoverZone"
              Grid.Row="2"
              Height="96"
              VerticalAlignment="Bottom"
              Background="#01000000"
              ZIndex="19"
              IsVisible="{Binding IsLyricsFullscreen}" />

      <!-- Floating Bottom Player Bar -->
      <Border x:Name="BottomPlayerBar"
              Grid.Row="2"
              ZIndex="20"
              Margin="12,4,12,12"
              CornerRadius="{DynamicResource CardCornerRadius}"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1"
              Padding="16,10">
        <StackPanel Spacing="6">
          <!-- Seek Scrub Bar -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding PositionDisplay}"
                       Classes="muted"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <Slider Grid.Column="1"
                    x:Name="SeekSlider"
                    Minimum="0"
                    Maximum="{Binding SeekMaxSeconds}"
                    Value="{Binding SeekPositionSeconds}"
                    IsEnabled="{Binding HasCurrentTrack}"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{Binding DurationDisplay}"
                       Classes="muted"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />
          </Grid>

          <!-- Track Info + Transport + Drawer/Volume + Headless/Kill -->
          <Grid ColumnDefinitions="*,Auto,*">
            <!-- Left: Art + Info + Heart -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <Border Grid.Column="0"
                      Width="46" Height="46"
                      CornerRadius="8"
                      Background="{DynamicResource SurfaceAltBrush}"
                      ClipToBounds="True"
                      Margin="0,0,12,0">
                <Grid>
                  <Image Source="{Binding CurrentAlbumArt}" Stretch="UniformToFill" IsVisible="{Binding HasCurrentAlbumArt}" />
                  <PathIcon Data="{x:Static svc:IconCatalog.Spotify}"
                            Foreground="{DynamicResource PrimaryAccentBrush}"
                            Width="20" Height="20"
                            IsVisible="{Binding !HasCurrentAlbumArt}" />
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Command="{Binding OpenCurrentTrackAlbumCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand"
                        ToolTip.Tip="Open Album">
                  <TextBlock Text="{Binding CurrentTrackTitle}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Command="{Binding OpenCurrentTrackArtistCommand}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalAlignment="Left"
                          Cursor="Hand"
                          ToolTip.Tip="Open Artist Profile">
                    <TextBlock Text="{Binding CurrentTrackArtist}"
                               Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="180" />
                  </Button>
                  <TextBlock Text="{Binding CurrentAudioSpec}"
                             Classes="muted"
                             FontSize="10"
                             Opacity="0.65"
                             VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <Button Grid.Column="2"
                      Classes="rem-icon"
                      Command="{Binding ToggleLikeCurrentCommand}"
                      IsEnabled="{Binding HasCurrentTrack}"
                      ToolTip.Tip="Like / Unlike song"
                      VerticalAlignment="Center">
                <Grid>
                  <PathIcon Data="{x:Static svc:IconCatalog.Heart}"
                            Foreground="#1DB954"
                            Width="15" Height="15"
                            IsVisible="{Binding IsCurrentTrackLiked}" />
                  <PathIcon Data="{x:Static svc:IconCatalog.HeartOutline}"
                            Width="15" Height="15"
                            IsVisible="{Binding !IsCurrentTrackLiked}" />
                </Grid>
              </Button>
            </Grid>

            <!-- Center: Shuffle, Prev, Play/Pause, Next, Repeat -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0">
              <Button Classes="rem-icon"
                      Command="{Binding ToggleShuffleCommand}"
                      ToolTip.Tip="Toggle Shuffle">
                <Grid>
                  <PathIcon Data="{x:Static svc:IconCatalog.Shuffle}"
                            Foreground="{DynamicResource PrimaryAccentBrush}"
                            Width="15" Height="15"
                            IsVisible="{Binding IsShuffled}" />
                  <PathIcon Data="{x:Static svc:IconCatalog.Shuffle}"
                            Width="15" Height="15"
                            Opacity="0.6"
                            IsVisible="{Binding !IsShuffled}" />
                </Grid>
              </Button>

              <Button Classes="rem-icon"
                      Command="{Binding PrevTrackCommand}"
                      ToolTip.Tip="Previous">
                <PathIcon Data="{x:Static svc:IconCatalog.SkipPrev}" Width="16" Height="16" />
              </Button>

              <Button Classes="rem-primary"
                      Command="{Binding TogglePlayPauseCommand}"
                      Width="40" Height="38"
                      CornerRadius="999"
                      Padding="0"
                      ToolTip.Tip="Play / Pause">
                <Grid>
                  <PathIcon Data="{x:Static svc:IconCatalog.Pause}"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Width="15" Height="15"
                            IsVisible="{Binding IsPlaying}" />
                  <PathIcon Data="{x:Static svc:IconCatalog.Play}"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Width="15" Height="15"
                            IsVisible="{Binding !IsPlaying}" />
                </Grid>
              </Button>

              <Button Classes="rem-icon"
                      Command="{Binding NextTrackCommand}"
                      ToolTip.Tip="Next">
                <PathIcon Data="{x:Static svc:IconCatalog.SkipNext}" Width="16" Height="16" />
              </Button>

              <Button Classes="rem-icon"
                      Command="{Binding CycleRepeatCommand}"
                      ToolTip.Tip="{Binding RepeatTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <PathIcon Data="{x:Static svc:IconCatalog.Repeat}" Width="15" Height="15" />
                  <TextBlock Text="{Binding RepeatLabel}"
                             FontSize="9"
                             FontWeight="Bold"
                             Foreground="{DynamicResource PrimaryAccentBrush}"
                             IsVisible="{Binding IsRepeatActive}"
                             VerticalAlignment="Top" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Right: Lyrics, Queue, Volume, Headless, Kill -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Classes="rem-icon"
                      Command="{Binding ToggleLyricsDrawerCommand}"
                      ToolTip.Tip="Toggle Synced Lyrics">
                <PathIcon Data="{x:Static svc:IconCatalog.Lyrics}" Width="14" Height="14" />
              </Button>

              <Button Classes="rem-icon"
                      Command="{Binding ToggleQueueDrawerCommand}"
                      ToolTip.Tip="Toggle Queue">
                <PathIcon Data="{x:Static svc:IconCatalog.QueueList}" Width="14" Height="14" />
              </Button>

              <PathIcon Data="{x:Static svc:IconCatalog.VolumeHigh}"
                        Width="14" Height="14"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center" />
              <Slider Minimum="0"
                      Maximum="100"
                      Value="{Binding Volume}"
                      Width="78"
                      VerticalAlignment="Center" />

              <Button Classes="rem-soft"
                      Command="{Binding MinimizeToHeadlessCommand}"
                      Margin="4,0,0,0"
                      ToolTip.Tip="Run Headless (disposes UI &amp; art, keeps audio playing)">
                <PathIcon Data="{x:Static svc:IconCatalog.Headless}" Width="14" Height="14" />
              </Button>

              <Button Classes="rem-danger"
                      Command="{Binding KillCommand}"
                      ToolTip.Tip="Kill Spotify Soloist engine">
                <PathIcon Data="{x:Static svc:IconCatalog.Kill}"
                          Foreground="{DynamicResource DangerFgBrush}"
                          Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
